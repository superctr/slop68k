; switches: /k /p /o ae-
; Expressions: operators, precedence, constants and labels.
	org	$100
	dc.l	-8>>1, $80000000>>4, -7/2, -7%2, 7/-2, 1<<31, 1<<32, 1<<33
	dc.l	5=5, 5<>5, 3>2, -1>2, $ffffffff>2, ~0, ~5, -(-3)
	dc.l	1+2*3, 2*3+1, 10-2-3, 100/10/2, 1|2&3, 1^3|4, 8>>1<<2
	dc.l	2<3=-1, 1+1=2, 3&1=1, 1=1&3
	dc.l	"A", "AB", "ABCD", 'A', 'AB'+1
	dc.l	*, *, @, @
	dc.w	$7fff, -$8000, $ffff, -1, 65535
	dc.b	255, -1, -128, $ff, 'A', "hello", 'it''s', "say ""hi""", 0
	dc.b	1,2 , 3, 4	, 5 ;comment
	dc.b	1 , 2
	dc.w	!1, 5!2
	dc.l	%1010, %11+1, 10%3, 10 % 3
	dc.l	(1+2)*3, ((4))
	dc.l	-1>>28, -1<<4, 3*-2, 3--2, 3-+2, 3+~2
	dc.l	1<2, 2<1, 1<=1, 2>=3, 1<<2<3
	dc.w	sqrt(16), sqrt(17)
lab1	dc.b	1
lab2:	dc.b	2
  lab3:	dc.b	3
	lab4: dc.b 4
lab5
	dc.b	5
lab6:
LAB7	dc.b	lab1-LAB2, Lab3&$ff
lab8 equ 5
lab9	=	6
lab10 = 7
	dc.b	lab8,lab9,lab10
lab9	=	lab9+1
lab11:	equ	9
	dc.b	lab9,lab11
	even
	dc.l	lab1,lab5,lab6,lab7
