; switches: /k /p /o ae-
; ORG, the layout of the output and the optimisation options.
	org	$100
	dc.b	1
	org	$110
	dc.b	2
	org	$108
	dc.b	3
	org	$120
back:
	opt	ow+
	move.w	back,d0
	move.w	$1234,d0
	move.w	$ffff8000,d0
	move.w	$8000,d0
	move.w	fwd,d0
	move.w	(back).l,d0
	jmp	back
	opt	ow-
	opt	os+
	bra	back
	bra	fwd
	bra.w	back
	beq	back
	bsr	back
	opt	os-
	opt	op+
	move.w	back,d0
	lea	back,a0
	jsr	back
	jsr	fwd
	move.w	d0,back
	opt	op-
	opt	oz+
	move.w	0(a0),d0
	move.w	zero(a0),d0
	move.w	fwdzero(a0),d0
	opt	oz-
	opt	oaq+,osq+,omq+
	add.w	#1,d0
	add.w	#8,d0
	add.w	#9,d0
	add.l	#1,a0
	addi.w	#1,d0
	sub.w	#1,d0
	move.l	#1,d0
	move.l	#-1,d0
	move.l	#$80,d0
	move.w	#1,d0
	move.l	#1,a0
	move.l	#1,(a0)
	add.w	#fwdzero+1,d0
	opt	oaq-,osq-,omq-
zero	equ	0
fwd:
fwdzero	equ	0
	move.w	#$ffff,d0
	move.w	#-1,d0
	move.w	#-$8000,d0
	move.b	#$ff,d0
	move.b	#-1,d0
	move.b	#-$80,d0
	moveq	#$ffffffff,d0
	move.w	-1(a0),d0
	move.w	$7fff(a0),d0
	move.w	-$8000(a0),d0
	move.w	$7f(a0,d0.w),d0
	move.w	-$80(a0,d0.w),d0
	dc.l	$ffffffff
	addq	#8,d0
