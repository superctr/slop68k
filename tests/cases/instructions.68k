; switches: /k /p /o ae-
; Instruction encodings and the forms asm68k picks for them.
	org	0
back:
	bra	back
	bra	fwd
	bra.s	near
	nop
near:
	bsr	fwd
	beq	fwd
	dbra	d0,back
	jmp	fwd
	jmp	back
	jsr	back(pc)
	move.w	fwd,d0
	move.w	back,d0
	move.w	($1234),d0
	move.w	$1234,d0
	move.w	($1234).w,d0
	move.w	$1234.w,d0
	move.w	($ffff8000).w,d0
	move.w	$ffff8000,d0
	move.w	($ff8000).l,d0
	move.l	#fwd,d0
	lea	fwd(pc),a0
	lea	near2(pc,d0.w),a0
	nop
near2:
	lea	back(pc,d0.l),a0
	move.w	0(a0),d0
	move.w	(a0),d0
	move.w	4(a0,d1.w),d0
	move.w	(4,a0,d1.w),d0
	move.w	(4,a0),d0
	move.w	(a0,d1),d0
	move.w	fwdequ(a0),d0
	add.w	#1,d0
	add.w	#1,(a0)
	add.w	#1,a0
	sub.w	#1,d0
	and.w	#1,d0
	or.w	#1,d0
	eor.w	#1,d0
	cmp.w	#1,d0
	cmp.w	#1,(a0)
	cmp.w	#1,a0
	cmp.w	(a0)+,(a1)+
	move.l	d0,a0
	move.w	d0,a0
	add.l	d0,a0
	add	d0,d1
	move	d0,d1
	move	sr,d0
	move	d0,sr
	move	d0,ccr
	move.l	usp,a0
	move.l	a0,usp
	and	#$fe,ccr
	or	#$700,sr
	andi	#$fe,ccr
	moveq	#-1,d0
	moveq	#$7f,d0
	moveq.l	#0,d0
	addq	#8,d0
	addq.w	#1,a0
	addq.l	#1,a0
	subq	#1,d0
	lsl.w	#1,d0
	lsl.w	#8,d0
	lsl.w	d1,d0
	lsl.w	(a0)
	lsl	(a0)
	asl.w	d0
	btst	#0,d0
	btst.b	#0,(a0)
	btst.l	#0,d0
	btst	d1,(a0)
	bset	#7,(a0)
	movem.l	d0-d7/a0-a6,-(sp)
	movem.l	(sp)+,d0-d7/a0-a6
	movem.w	d0,-(sp)
	movem.l	d0/a0,4(a0)
	movep.w	0(a0),d0
	movep.l	d0,4(a0)
	swap	d0
	ext.w	d0
	ext.l	d0
	ext	d0
	exg	d0,d1
	exg	a0,a1
	exg	d0,a1
	exg	a1,d0
	link	a6,#-4
	unlk	a6
	trap	#0
	stop	#$2700
	st	d0
	st.b	(a0)
	tas	d0
	tas.b	(a0)
	clr	d0
	tst	d0
	neg	d0
	not	d0
	mulu	d0,d1
	muls.w	#5,d1
	divu	(a0),d1
	chk	d0,d1
	pea	fwd
	pea	4(a0)
	nop
	rts
	rte
	rtr
	reset
	trapv
	illegal
	abcd	d0,d1
	sbcd	-(a0),-(a1)
	addx.w	d0,d1
	subx.l	-(a0),-(a1)
	nbcd	d0
	cmpm.b	(a0)+,(a1)+
	cmpa.w	d0,a0
	adda.w	#4,a0
	suba.l	a1,a0
	movea.l	4.w,a6
	bhs.s	fwd
	blo.s	fwd
	dbf	d0,back
	dbhs	d0,back
	shs	d0
	slo	d0
fwd:
fwdequ	equ	6
	rts
